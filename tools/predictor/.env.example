CHURN_INFER_URL=
FRAUD_INFER_URL=
QOE_INFER_URL=
INFER_TOKEN=
# Optional mounted token file; takes precedence and supports token rotation.
INFER_TOKEN_FILE=
INFER_TIMEOUT=30
# Optional trusted CA bundle for data fetch and inference HTTPS requests.
# SSL_CERT_FILE=/path/to/ca-bundle.pem
CACHE_TTL=300
CACHE_MAXSIZE=512
BATCH_MAX_SIZE=32
BATCH_WAIT_MS=10
QOE_POOR_THRESHOLD=40
QOE_GOOD_THRESHOLD=70
# Data fetch service base URL; PostgreSQL credentials belong to that service.
DATA_FETCH_URL=
DATA_FETCH_TIMEOUT=30
# Optional gateway bearer token, separate from INFER_TOKEN.
DATA_FETCH_TOKEN=
# Required for QoE: load artifacts from S3 using the standard AWS credential chain.
AWS_S3_ENDPOINT=
S3_BUCKET=
S3_MODEL_PATH=
# Optional trusted CA bundle for S3 HTTPS requests.
# AWS_CA_BUNDLE=/path/to/s3-ca-bundle.pem
